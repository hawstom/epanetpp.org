RewriteEngine On
# Every path with a directory segment beginning with a dot (.git above all) is a 404, as on the
# sibling sites; mod_alias, so it needs no AllowOverride Options.
RedirectMatch 404 "/\.(?!well-known/)[^/]+/"
RewriteCond %{HTTP_HOST} ^(www\.)?epanetpp\.org$ [NC]
RewriteRule ^(.*)$ https://epanet-plus-plus.org/$1 [R=301,L]
